# Expo public variables end up in the app bundle: never put a secret here.
EXPO_PUBLIC_BFF_URL=http://localhost:3000
EXPO_PUBLIC_OIDC_ISSUER=http://localhost:8180/realms/symbiomed
EXPO_PUBLIC_OIDC_CLIENT_ID=symbiomed-mobile
# 1 = sign in against `pnpm dev:mock` (dev token route), no Keycloak.
EXPO_PUBLIC_MOCK=0
