{
  "name": "@symbiomed/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "demo:web": "cross-env EXPO_PUBLIC_DEMO=1 expo start --web --port 8081",
    "typecheck": "tsc -p .",
    "test": "jest --ci",
    "export": "expo export --platform android --platform ios --output-dir dist"
  },
  "dependencies": {
    "@expo-google-fonts/atkinson-hyperlegible": "0.4.1",
    "@expo/metro-runtime": "57.0.16",
    "@expo/vector-icons": "15.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.0",
    "@symbiomed/api-client": "workspace:*",
    "@symbiomed/brace-protocol": "workspace:*",
    "@symbiomed/domain": "workspace:*",
    "@symbiomed/i18n": "workspace:*",
    "@symbiomed/ui-tokens": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "expo": "57.0.27",
    "expo-auth-session": "57.0.14",
    "expo-constants": "57.0.21",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-font": "57.0.4",
    "expo-haptics": "57.0.3",
    "expo-linking": "57.0.12",
    "expo-local-authentication": "57.0.3",
    "expo-localization": "57.0.2",
    "expo-router": "57.0.25",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "expo-web-browser": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.3.0",
    "react-native": "0.86.3",
    "react-native-ble-plx": "3.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@symbiomed/fixtures": "workspace:*",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "cross-env": "10.1.0",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "react-test-renderer": "19.2.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./test/setup.ts"
    ],
    "testMatch": [
      "<rootDir>/test/**/*.test.tsx",
      "<rootDir>/test/**/*.test.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(?:\\.pnpm/[^/]+/node_modules/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|expo-.*|react-navigation|@react-navigation/.*|react-native-svg|@tanstack/.*))"
    ]
  }
}
