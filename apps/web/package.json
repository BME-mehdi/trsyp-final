    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5",
    "@symbiomed/ui-tokens": "workspace:*",
