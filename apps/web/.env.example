# Copy to .env.local. The BFF refuses to start when a required variable is missing.
FHIR_BASE_URL=http://localhost:8090/fhir
AUTH_MODE=oidc
OIDC_ISSUER=http://localhost:8180/realms/symbiomed
OIDC_AUDIENCE=symbiomed-bff
# AUTH_MODE=dev only for local work and tests; refused when NODE_ENV=production.
# DEV_AUTH_SECRET=
RATE_LIMIT_PER_MINUTE=120
# EXTENSION POINT: the existing Node.js backend running Model B ($suggest-plan). Unset = fixtures.
# SYMBIOMED_BACKEND_URL=http://localhost:4000
